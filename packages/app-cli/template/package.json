{
  "name": "__APP_ID__",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build:screens": "esbuild src/screen.ts --bundle --format=esm --target=es2022 --outfile=public/screen.js",
    "dev": "npm run build:screens && wrangler dev",
    "deploy": "npm run build:screens && wrangler deploy",
    "validate": "amable-app validate manifest.json",
    "test:conformance": "amable-app test --manifest manifest.json"
  },
  "dependencies": {
    "@amable/app-bridge": "^0.1.0",
    "@amable/app-sdk": "^0.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "amable-app": "^0.1.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "wrangler": "^4.151.0"
  }
}

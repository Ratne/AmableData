# dependencies
node_modules/

# build output
dist/

# wrangler local state
.wrangler/

# local secrets (keep .dev.vars.example committed)
.dev.vars

# local living documentation (never committed)
graphify-out/
obsidian/

# local-only files
*.local

# rendered by scripts/self-host-setup.mjs (account-specific ids)
apps/*/wrangler.self-host*.jsonc

# misc
.DS_Store
coverage/
*.log

# generated by scripts/dev.mjs (dev-only bindings and local origins)
apps/*/wrangler.dev.jsonc

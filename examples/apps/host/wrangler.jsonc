{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amable-apps",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "apps.amabledata.com", "custom_domain": true }],
  // Built by `pnpm build`: public/<app id>/ holds each app's screens and icon.
  "assets": { "directory": "./public" },
  "kv_namespaces": [{ "binding": "INSTALLS", "id": "74a23389631f4ccc91767e5bcd46c441" }],
  // Secrets, one signing key set per app: EMAILABLE_APP_KEYS, KAPSO_APP_KEYS
  // (in the app folder: npx amable-app keys secret | npx wrangler secret put KAPSO_APP_KEYS)
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amable-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Sealing a long signed PDF can take more CPU than the 30 s default.
  "limits": { "cpu_ms": 120000 },

  // SPA assets built by apps/web (`pnpm build:web`). API routes always hit the worker.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The worker serves documents too (CSP nonce + preferences injected before first
    // paint); hashed static files under /assets/* bypass it.
    "run_worker_first": ["/*", "!/assets/*"],
  },

  // Installation database. The id is a placeholder: local dev never talks to the
  // Cloudflare API, and the installer (control-plane phase) provisions the real
  // database on the customer account and rewrites this value.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amable-installation",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],

  "durable_objects": {
    "bindings": [
      { "name": "TENANT_DB", "class_name": "TenantDb" },
      { "name": "ENGINE", "class_name": "Engine" },
      { "name": "MAIL_DB", "class_name": "MailDb" },
      // Landing page editing locks (one per page) and booking calendars (one per calendar).
      { "name": "EDIT_SESSION", "class_name": "EditSession" },
      { "name": "BOOKING_CALENDAR", "class_name": "BookingCalendar" },
      // Web analytics DOs live in the edge worker (deploy amable-edge first).
      { "name": "ANALYTICS", "class_name": "AnalyticsDO", "script_name": "amable-edge" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TenantDb", "Engine"] },
    { "tag": "v2", "new_sqlite_classes": ["MailDb"] },
    { "tag": "v3", "new_sqlite_classes": ["EditSession", "BookingCalendar"] },
  ],

  "queues": {
    "producers": [
      { "binding": "EMAIL_SEND", "queue": "email-send" },
      { "binding": "EVENTS_ROLLUP", "queue": "events-rollup" },
      { "binding": "WEBHOOKS_OUT", "queue": "webhooks-out" },
      // Encrypted form submissions → CRM contact, form.submitted, external connections.
      { "binding": "FORM_SUBMISSIONS", "queue": "form-submissions" },
      // Signed-PDF jobs of completed signature requests (out of the tenant Durable Object).
      { "binding": "ESIGN_SEAL", "queue": "esign-seal" },
    ],
    "consumers": [
      // Deferrals (warm-up cap, rate limit, paused broadcast) are retries too: the
      // pipeline counts real provider attempts itself (max 5), hence the high limit.
      { "queue": "email-send", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 100 },
      { "queue": "events-rollup", "max_batch_size": 10, "max_batch_timeout": 5 },
      { "queue": "webhooks-out", "max_batch_size": 10, "max_batch_timeout": 5 },
      { "queue": "form-submissions", "max_batch_size": 10, "max_batch_timeout": 2, "max_retries": 10 },
      // One PDF per invocation; lost jobs come back through the TenantDb alarm lease.
      { "queue": "esign-seal", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 2 },
    ],
  },

  // File/image/backup storage stub. Local dev simulates R2; the installer creates
  // the real bucket.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "amable-files" }],

  // Platform link cron: heartbeat, usage blocks, error outbox, assisted-access expiry
  // (no-ops without LICENSE_KEY). Test locally with: wrangler dev --test-scheduled
  "triggers": { "crons": ["*/5 * * * *"] },

  // Workers Rate Limiting (coarse per-IP limits for auth endpoints and API keys).
  // Exact per-account limits use D1 counters, which are also the fallback.
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_API", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } },
  ],

  // Local default. The installer / fleet manager sets ENVIRONMENT=production on
  // deploy, which removes every /api/dev/* route.
  // EDGE_ORIGIN: public origin of the edge worker, used in tracking snippets.
  // EMAIL_ALLOW_UNVERIFIED_DOMAIN: local sends without a verified domain (ignored outside dev).
  // Custom tracking domains. Domains added as zones of the same Cloudflare account
  // ("zone" kind: proxied record + worker route, verified by probing the edge) need
  // NO configuration here. The "cname" kind (DNS elsewhere, Cloudflare for SaaS custom
  // hostnames on the zone serving the edge worker; dev uses a fake provider) needs:
  // CF_ZONE_ID = that zone, CF_API_TOKEN = token with "SSL and Certificates: Edit"
  // (Wrangler secret), TRACKING_CNAME_TARGET = hostname customers point their CNAME
  // at (default: EDGE_ORIGIN host).
  "vars": {
    "ENVIRONMENT": "dev",
    "EDGE_ORIGIN": "http://localhost:8788",
    "EMAIL_ALLOW_UNVERIFIED_DOMAIN": "true",
    // "CF_ZONE_ID": "<zone id>",
    // "TRACKING_CNAME_TARGET": "track.example.net",
    // Ad platform OAuth apps: secrets via `wrangler secret put <NAME>` (a platform
    // without them is unavailable outside dev, where a fake client is used).
    // META_APP_ID, META_APP_SECRET; GOOGLE_ADS_CLIENT_ID, GOOGLE_ADS_CLIENT_SECRET,
    // GOOGLE_ADS_DEVELOPER_TOKEN, GOOGLE_ADS_LOGIN_CUSTOMER_ID (optional manager
    // account); TIKTOK_APP_ID, TIKTOK_APP_SECRET.
    // Redirect URI registered on those apps (default: <APP_ORIGIN>/oauth/ads/callback):
    // "ADS_OAUTH_REDIRECT_URI": "https://app.example.com/oauth/ads/callback",
  },

  "dev": { "port": 8787 },
}

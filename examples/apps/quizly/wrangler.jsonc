{
  // Local development only (`pnpm run dev`). In production the CRM deploys this
  // app into the workspace's own Cloudflare account (see docs/apps/README.md),
  // with the database declared in the manifest `deployment`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amable-app-quizly",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [{ "binding": "DB", "database_name": "amable-app-quizly-db" }],
}

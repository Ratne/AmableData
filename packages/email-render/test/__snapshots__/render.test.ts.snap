// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`compileEmail > generates the plain-text version from the same document 1`] = `
"[Logo]

AUTUMN NEWS

Hi {{ contact.first_name | default: "there" }}, here is what is new — read the blog (https://example.com/blog?a=1&b=2).

- Faster search
- New reports

Open the app: https://example.com/app

Left column

Right column

---

{% if contact.tags contains "VIP" %}Thanks for being a VIP.{% else %}Upgrade to VIP today.{% endif %}

{% if order.total > 100 %}Free shipping on your next order.{% endif %}

---

You receive this because you signed up.

Unsubscribe from these emails: {{ unsubscribe_url }}"
`;

exports[`compileEmail > produces a table-based, inline-styled, fixed-width HTML template 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="en"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><meta name="color-scheme" content="light"/><meta name="supported-color-schemes" content="light"/></head><body style="background-color:#f4f4f5;margin:0;padding:0"><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="margin:0;padding:24px 0;background-color:#f4f4f5;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif"><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0">News for {{ contact.first_name }} ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏  ͏ </div><table align="center" width="600" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:600px;width:100%;background-color:#ffffff;border-radius:8px;padding:32px;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="border-bottom:1px solid #e7e7e7;margin-bottom:24px;padding-bottom:8px"><tbody><tr><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin:0 0 16px"><tbody><tr><td><a href="https://example.com" style="color:#067df7;text-decoration-line:none" target="_blank"><img alt="Logo" src="https://cdn.example.com/logo.png" style="display:block;outline:none;border:0;text-decoration:none;max-width:100%;height:auto;margin:0 auto" width="120"/></a></td></tr></tbody></table></td></tr></tbody></table><h1 style="margin:0 0 12px;font-weight:600;color:#161616;text-align:center;font-size:30px;line-height:38px">Autumn news</h1><p style="font-size:16px;line-height:26px;margin:0 0 16px;color:#161616;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Hi {{ contact.first_name | default: "there" }}, here is what is <strong>new</strong> — read the <a href="https://example.com/blog?a=1&amp;b=2" style="color:#2563eb;text-decoration-line:none;text-decoration:underline" target="_blank">blog</a>.</p><ul style="margin:0 0 16px;padding-left:24px;color:#161616"><li style="margin:0 0 4px;font-size:16px;line-height:26px">Faster search</li><li style="margin:0 0 4px;font-size:16px;line-height:26px">New reports</li></ul><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin:8px 0 24px;text-align:center"><tbody><tr><td><a href="https://example.com/app" style="line-height:20px;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#16a34a;color:#ffffff;border-radius:8px;font-size:16px;font-weight:600;padding:12px 24px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px" target="_blank"><span><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:18" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px">Open the app</span><span><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody><tr><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody style="width:100%"><tr style="width:100%"><td data-id="__react-email-column" style="height:16px;line-height:16px;font-size:1px"> </td></tr></tbody></table></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin:0 0 16px"><tbody><tr><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation"><tbody style="width:100%"><tr style="width:100%"><td width="50%" data-id="__react-email-column" style="width:50%;vertical-align:top;padding-left:0;padding-right:8px"><p style="font-size:16px;line-height:26px;margin:0 0 16px;color:#161616;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Left column</p></td><td width="50%" data-id="__react-email-column" style="width:50%;vertical-align:top;padding-left:8px;padding-right:0"><p style="font-size:16px;line-height:26px;margin:0 0 16px;color:#161616;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Right column</p></td></tr></tbody></table></td></tr></tbody></table><hr style="width:100%;border:none;border-top:1px solid #e7e7e7;margin:24px 0"/>{% if contact.tags contains "VIP" %}<p style="font-size:16px;line-height:26px;margin:0 0 16px;color:#161616;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Thanks for being a VIP.</p>{% else %}<p style="font-size:16px;line-height:26px;margin:0 0 16px;color:#161616;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Upgrade to VIP today.</p>{% endif %}{% if order.total > 100 %}<p>Free shipping on your next order.</p>{% endif %}<table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="border-top:1px solid #e7e7e7;margin-top:24px;padding-top:16px"><tbody><tr><td><p style="font-size:12px;line-height:18px;margin:0 0 8px;color:#737373;text-align:center;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">You receive this because you signed up.</p><p style="font-size:12px;line-height:18px;margin:0 0 8px;color:#737373;text-align:center;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0"><a href="{{ unsubscribe_url }}" style="color:#737373;text-decoration-line:none;text-decoration:underline" target="_blank">Unsubscribe from these emails</a></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></body></html>"`;

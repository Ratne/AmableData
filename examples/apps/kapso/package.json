{
  "name": "@amable/example-app-kapso",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build:screens": "esbuild settings=src/settings-screen.ts templates=src/templates-screen.ts --bundle --format=esm --target=es2022 --outdir=public",
    "dev": "pnpm run build:screens && wrangler dev",
    "bundle": "pnpm run build:screens && node ../../../scripts/bundle-app.mjs .",
    "typecheck": "tsc -p . && tsc -p tsconfig.screens.json && tsc -p tsconfig.scripts.json",
    "record-fixtures": "esbuild scripts/record-fixtures.ts --bundle --platform=node --format=esm --outfile=.wrangler/record-fixtures.mjs --log-level=warning && node .wrangler/record-fixtures.mjs",
    "test": "vitest run --root ../../.. examples/apps/kapso"
  },
  "dependencies": {
    "@amable/app-bridge": "workspace:*",
    "@amable/app-sdk": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "typescript": "~5.9.3",
    "wrangler": "^4.151.2"
  }
}

{
  "name": "@amable/example-app-emailable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build:screens": "esbuild src/screen.ts --bundle --format=esm --target=es2022 --outfile=public/screen.js",
    "dev": "pnpm run build:screens && wrangler dev",
    "deploy": "pnpm run build:screens && wrangler deploy",
    "test": "vitest run --root ../../.. examples/apps/emailable",
    "typecheck": "tsc -p . && tsc -p tsconfig.scripts.json",
    "record-fixtures": "esbuild scripts/record-fixtures.ts --bundle --platform=node --format=esm --outfile=.wrangler/record-fixtures.mjs --log-level=warning && node .wrangler/record-fixtures.mjs"
  },
  "dependencies": {
    "@amable/app-bridge": "workspace:*",
    "@amable/app-sdk": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "typescript": "~5.9.3",
    "wrangler": "^4.151.0"
  }
}

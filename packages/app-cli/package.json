{
  "name": "amable-app",
  "version": "0.1.0",
  "description": "CLI for AmableData app developers: create-amable-app, keys, validate, conformance tests",
  "type": "module",
  "license": "AGPL-3.0-only",
  "bin": {
    "amable-app": "./bin/amable-app.mjs",
